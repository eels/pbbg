{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "jsx": "react-jsx",
    "jsxImportSource": "@builder.io/qwik",
    "paths": {
      "@/web/*": ["./src/*"]
    }
  },
  "exclude": ["node_modules"],
  "include": ["../../packages/content/.contentlayer/generated", "**/*.astro", "**/*.ts", "**/*.tsx"]
}
