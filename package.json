{
  "name": "@pbbg/root",
  "private": true,
  "type": "module",
  "version": "3.0.0",
  "author": "Liam Howell <liam@liam.codes>",
  "repository": "https://github.com/eels/pbbg",
  "bugs": "https://github.com/eels/pbbg/issues",
  "license": "GPL-3.0-or-later",
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "applications/*",
    "configs/*",
    "packages/*"
  ],
  "scripts": {
    "build:web": "dotenv -- turbo run build --filter=@pbbg/web...",
    "build": "dotenv -- turbo run build",
    "clean:artifacts": "yarn rimraf \"**/tsconfig.tsbuildinfo\"",
    "clean:dependencies": "yarn rimraf \"**/node_modules/\"",
    "clean": "turbo run clean && yarn clean:artifacts",
    "dev:web": "dotenv -- turbo run dev --filter=@pbbg/web...",
    "dev": "dotenv -- turbo run dev",
    "lint:eslint:fix": "yarn lint --fix",
    "lint:eslint": "eslint \"./{**/,}*.{astro,cjs,js,json,mjs,ts,tsx}\" --cache",
    "lint:fix": "concurrently \"yarn lint:eslint:fix\" \"yarn lint:stylelint:fix\"",
    "lint:stylelint:fix": "yarn lint:stylelint --fix",
    "lint:stylelint": "stylelint \"./{**/,}*.{css,scss}\" --cache",
    "lint": "concurrently \"yarn lint:eslint\" \"yarn lint:stylelint\"",
    "optimise:svg": "yarn svgo --folder \"./assets/icons\" --output \"./assets/icons\"",
    "prepare": "husky install",
    "start:web": "dotenv -- turbo run start --filter=@pbbg/web",
    "test:dependencies": "yarn syncpack list-mismatches",
    "test": "jest --cache --maxWorkers 50% --passWithNoTests",
    "typescript:verify": "turbo run typescript:verify"
  },
  "dependencies": {
    "dotenv-cli": "7.3.0",
    "dotenv-vault": "1.25.0",
    "dotenv": "16.3.1",
    "turbo": "1.11.3"
  },
  "devDependencies": {
    "@commitlint/cli": "17.7.1",
    "@commitlint/config-conventional": "17.7.0",
    "@pbbg/eslint-config": "*",
    "@pbbg/stylelint-config": "*",
    "@pbbg/typescript-config": "*",
    "@types/jest": "29.5.3",
    "@types/svgo": "2.6.4",
    "concurrently": "8.2.2",
    "husky": "8.0.3",
    "jest-environment-jsdom": "29.6.1",
    "jest-transform-css": "6.0.1",
    "jest": "29.6.1",
    "lint-staged": "14.0.1",
    "parse5": "7.1.2",
    "rimraf": "5.0.1",
    "svgo": "3.0.2",
    "syncpack": "11.2.1",
    "ts-jest": "29.1.1",
    "wait-on": "7.0.1"
  }
}
