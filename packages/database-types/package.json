{
  "name": "@pbbg/database-types",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "exports": {
    "./*": {
      "default": "./dist/*.js",
      "types": "./dist/*.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --project \"./tsconfig.build.json\" && tsc-alias",
    "clean": "rimraf \"./dist\"",
    "dev": "onchange --initial \"./src/**/*.{js,json,ts}\" -- yarn build",
    "typescript:verify": "tsc --noEmit",
    "wait": "wait-on \"./dist\""
  },
  "dependencies": {
    "pocketbase": "0.21.4"
  },
  "devDependencies": {
    "@pbbg/typescript-config": "*"
  }
}
