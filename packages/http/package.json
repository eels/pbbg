{
  "name": "@pbbg/http",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "exports": {
    "./*": {
      "default": "./dist/*.js",
      "types": "./dist/*.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --project \"./tsconfig.build.json\" && tsc-alias",
    "clean": "rimraf \"./dist\"",
    "dev": "onchange --initial \"./src/**/*.{js,json,ts}\" -- yarn build",
    "typescript:verify": "tsc --noEmit",
    "wait": "wait-on \"./dist\""
  },
  "dependencies": {
    "@pbbg/utilities": "*",
    "axios": "1.7.3",
    "hono": "4.5.3",
    "timestring": "7.0.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@pbbg/typescript-config": "*",
    "jose": "5.6.3",
    "rate-limiter-flexible": "5.0.3"
  }
}
