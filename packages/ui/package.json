{
  "name": "@pbbg/ui",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "qwik": "./dist/index.qwik.mjs",
  "exports": {
    ".": {
      "default": "./dist/index.qwik.mjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build:dts": "tsc --project \"./tsconfig.build.json\" && tsc-alias",
    "build": "vite build --mode lib && yarn build:dts",
    "clean": "rimraf \"./dist\"",
    "dev": "onchange --initial \"./src/**/*.{js,json,ts,tsx}\" -- yarn build",
    "typescript:verify": "tsc --emitDeclarationOnly false --noEmit",
    "wait": "wait-on \"./dist\""
  },
  "dependencies": {
    "@pbbg/utilities": "*"
  },
  "devDependencies": {
    "@builder.io/qwik": "1.7.1",
    "@pbbg/typescript-config": "*",
    "@testing-library/jest-dom": "6.4.8",
    "vite-tsconfig-paths": "4.3.2",
    "vite": "5.3.2"
  }
}
