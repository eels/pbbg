{
  "name": "@pbbg/ui",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "exports": {
    "./*": ["./src/*.ts", "./src/*.tsx"]
  },
  "scripts": {
    "build": "vite build --mode lib",
    "clean": "rimraf \"./dist\"",
    "dev": "onchange --initial \"./src/**/*.{js,json,ts,tsx}\" -- yarn build",
    "typescript:verify": "tsc --noEmit",
    "wait": "wait-on \"./dist\""
  },
  "devDependencies": {
    "@builder.io/qwik": "1.7.1",
    "@pbbg/typescript-config": "*",
    "@testing-library/jest-dom": "6.4.8",
    "vite-tsconfig-paths": "4.3.2",
    "vite": "5.3.2"
  }
}
