{
  "extends": "@pbbg/typescript-config/lib/tsconfig.json",
  "compilerOptions": {
    "baseUrl": "../../",
    "jsx": "preserve",
    "paths": {
      "@/http/*": ["./packages/http/src/*"],
      "@/styles/*": ["./packages/styles/src/*"],
      "@/ui/*": ["./packages/ui/src/*"],
      "@/utilities/*": ["./packages/utilities/src/*"],
      "@/validators/*": ["./packages/validators/src/*"]
    }
  },
  "exclude": ["node_modules"],
  "include": ["**/*.ts", "**/*.tsx"]
}
